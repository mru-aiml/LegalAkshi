DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/legalakshi
# Local Vite dev origins (comma-separated, no wildcard). Must include the
# exact origin the browser uses — scheme + host + port. The 172.20.128.1
# entry is this dev machine's LAN IP serving Vite; adjust if yours differs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://172.20.128.1:5174
ENGINE_VERSION=1.0.0
# Production auth: Clerk JWKS endpoint (enables JWT verification; dev role
# headers are then ignored). Leave empty for documented local-dev identity.
CLERK_JWKS_URL=
CLERK_AUDIENCE=
# Server-controlled officer/admin assignment by verified Clerk user ID.
# Works with DEFAULT Clerk session tokens (no JWT template changes needed):
#   1. Clerk dashboard -> Users -> click the officer -> copy "User ID" (user_...)
#   2. OFFICER_USER_IDS=user_abc123,user_def456  (comma-separated, no spaces needed)
#   3. Restart the backend (uvicorn reads env at startup).
# Optional production alternative: a Clerk JWT template that embeds
# {"role": "{{user.public_metadata.role}}"} — then publicMetadata.role in the
# Clerk dashboard alone suffices and these maps can stay empty.
OFFICER_USER_IDS=
ADMIN_USER_IDS=
# Optional hybrid OCR: absolute path to the Tesseract 5 executable used
# solely by the targeted ingredient fallback (RapidOCR stays primary).
# Leave empty to run pure-RapidOCR; the service degrades gracefully when
# the binary is absent. Example (Windows):
# OCR inspection pipeline (extraction only, never compliance decisions).
# OCR_MAX_IMAGES caps TOTAL package images per inspection (front + back
# + extras, max 8; the listing screenshot is a separate slot).
# OCR_TIMEOUT_SECONDS is the end-to-end extraction budget honored by
# the Scan & Inspect UI for a full 8-photo inspection.
# LEGALAKSHI_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
LEGALAKSHI_TESSERACT_CMD=
OCR_MAX_IMAGES=8
OCR_TIMEOUT_SECONDS=420
# Local-dev fixed role (consumer|officer|admin). Empty = per-request headers.
DEV_AUTH_ROLE=
# Stage 2 — Package Intelligence vision provider (extraction ONLY, never
# compliance decisions). Disabled by default: OCR-only flow continues.
#   LEGALAKSHI_VISION_PROVIDER=  ("", "mock", or "gemini")
#   LEGALAKSHI_VISION_MODEL=     (e.g. gemini-3.8-flash)
#   GEMINI_MODEL=                (preferred alias; wins over the above)
#   LEGALAKSHI_VISION_API_KEY=   (server-side only, never logged/exposed)
#   GEMINI_API_KEY=              (accepted alias for the same secret)
#   LEGALAKSHI_VISION_ENABLED=false
# Key resolution order: LEGALAKSHI_VISION_API_KEY, then GEMINI_API_KEY.
# GET /api/v1/package-intelligence/vision-status reports whether Gemini
# is enabled / configured / missing-key WITHOUT exposing the key.
LEGALAKSHI_VISION_PROVIDER=
LEGALAKSHI_VISION_MODEL=gemini-3.8-flash
LEGALAKSHI_VISION_API_KEY=
GEMINI_API_KEY=
LEGALAKSHI_VISION_ENABLED=false
# Second pass shape: true = one consolidated Gemini call (all wanted
# fields, one representative original photo) first, grouped region
# crops only for fields still uncovered. False = grouped-only plan.
# Per-call budget 30s and overall budget 100s are code defaults in
# vision_stage (kept tight so a hung model degrades to OCR-only).
LEGALAKSHI_VISION_CONSOLIDATED=true
