DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/legalakshi
# Local Vite dev origins (comma-separated, no wildcard). Must include the
# exact origin the browser uses — scheme + host + port. The 172.20.128.1
# entry is this dev machine's LAN IP serving Vite; adjust if yours differs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://172.20.128.1:5174
ENGINE_VERSION=1.0.0
# Production auth: Clerk JWKS endpoint (enables JWT verification; dev role
# headers are then ignored). Leave empty for documented local-dev identity.
CLERK_JWKS_URL=
CLERK_AUDIENCE=
# Server-controlled officer/admin assignment by verified Clerk user ID.
# Works with DEFAULT Clerk session tokens (no JWT template changes needed):
#   1. Clerk dashboard -> Users -> click the officer -> copy "User ID" (user_...)
#   2. OFFICER_USER_IDS=user_abc123,user_def456  (comma-separated, no spaces needed)
#   3. Restart the backend (uvicorn reads env at startup).
# Optional production alternative: a Clerk JWT template that embeds
# {"role": "{{user.public_metadata.role}}"} — then publicMetadata.role in the
# Clerk dashboard alone suffices and these maps can stay empty.
OFFICER_USER_IDS=
ADMIN_USER_IDS=
# Optional hybrid OCR: absolute path to the Tesseract 5 executable used
# solely by the targeted ingredient fallback (RapidOCR stays primary).
# Leave empty to run pure-RapidOCR; the service degrades gracefully when
# the binary is absent. Example (Windows):
# LEGALAKSHI_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
LEGALAKSHI_TESSERACT_CMD=
# Local-dev fixed role (consumer|officer|admin). Empty = per-request headers.
DEV_AUTH_ROLE=
