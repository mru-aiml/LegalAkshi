VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8000
# OCR extraction budget in ms for up to 8 package photos (default
# 420000 = 7 min, matching backend OCR_TIMEOUT_SECONDS). Override only
# if the deployment needs a different end-to-end extraction budget.
# VITE_OCR_TIMEOUT_MS=420000
# Vite dev server port/base (read by vite.config.ts via loadEnv; real shell
# environment variables take precedence when set).
PORT=5174
BASE_PATH=/